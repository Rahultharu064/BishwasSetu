generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providers provider[] // ✅ ADD THIS LINE
  service   Service[]
}

model kycdocument {
  id         Int                @id @default(autoincrement())
  providerId Int
  type       kycdocument_type
  fileUrl    String
  status     kycdocument_status @default(PENDING)
  createdAt  DateTime           @default(now())
  provider   provider           @relation(fields: [providerId], references: [id], onDelete: Cascade, map: "KYCDocument_providerId_fkey")

  @@index([providerId], map: "KYCDocument_providerId_fkey")
}

model provider {
  id                    Int                         @id @default(autoincrement())
  userId                Int                         @unique(map: "Provider_userId_key")
  categoryId            String?
  legalName             String
  experienceYears       Int
  bio                   String                      @db.Text
  skills                String?                     @db.Text
  prevCompany           String?
  prevRole              String?
  workDuration          String?
  portfolioUrls         String?                     @db.Text
  tradeLicenseUrl       String?
  serviceDistrict       String?
  serviceMunicipality   String?
  availabilityDays      String?
  availabilityTime      String?
  isEmergencyAvailable  Boolean                     @default(false)
  emergencyResponseTime String?
  emergencyExtraCharge  Float?
  price                 Float?
  duration              String?
  profilePhotoUrl       String?
  verificationStatus    provider_verificationStatus @default(INCOMPLETE)
  trustScore            Float                       @default(0)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime
  category              Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "Provider_categoryId_fkey")
  kycDocuments          kycdocument[]
  user                  user                        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Provider_userId_fkey")
  service               Service[]
  bookings              Booking[]
  trustScoreEvents      TrustScoreEvent[]
  kycAiDecisions        KycAiDecision[]
  creditPurchases       CreditPurchase[]
  creditWallet          CreditWallet?
  creditDeductions      CreditDeduction[]
  badges                ProviderBadge[]
  reviews               Review[]
  complaints            Complaint[]
}

model Service {
  id          Int       @id @default(autoincrement())
  providerId  Int
  categoryId  String
  title       String
  icon        String?   @db.VarChar(50)
  description String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "Service_categoryId_fkey")
  provider    provider  @relation(fields: [providerId], references: [id], onDelete: Cascade, map: "Service_providerId_fkey")
  bookings    Booking[]

  @@index([categoryId], map: "Service_categoryId_fkey")
  @@index([providerId], map: "Service_providerId_fkey")
}

model Booking {
  id          Int            @id @default(autoincrement())
  customerId  Int
  providerId  Int
  serviceId   Int
  bookingDate DateTime
  status      booking_status @default(PENDING)
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime
  customer          user              @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade, map: "Booking_customerId_fkey")
  provider          provider          @relation(fields: [providerId], references: [id], onDelete: Cascade, map: "Booking_providerId_fkey")
  service           Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade, map: "Booking_serviceId_fkey")
  creditDeductions  CreditDeduction[]
  reviews           Review[]
  complaints        Complaint[]

  @@index([customerId], map: "Booking_customerId_fkey")
  @@index([providerId], map: "Booking_providerId_fkey")
  @@index([serviceId], map: "Booking_serviceId_fkey")
}

model user {
  id               Int         @id @default(autoincrement())
  email            String      @unique(map: "User_email_key")
  name             String?
  address          String?
  district         String?
  municipality     String?
  gender           String?
  phone            String?
  password         String
  role             user_role
  status           user_status @default(ACTIVE)
  isVerified       Boolean     @default(false)
  lastLogin        DateTime?
  otp              String?
  otpExpiry        DateTime?
  createdAt        DateTime    @default(now())
  provider          provider?
  customerBookings  Booking[]          @relation("CustomerBookings")
  assistantSessions AssistantSession[]
  verifiedBadges    ProviderBadge[]    @relation("AdminVerifiedBadges")
  reviews           Review[]
  complaints        Complaint[]
}

enum kycdocument_type {
  GOVERNMENT_ID
  CERTIFICATE
  PROFILE_PHOTO
}

enum kycdocument_status {
  PENDING
  APPROVED
  REJECTED
}

enum user_role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum user_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum provider_verificationStatus {
  INCOMPLETE
  DOCUMENTS_PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum booking_status {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ==========================================
// NEW MODELS ADDED FOR AI & CREDITS
// ==========================================

// Knowledge base for RAG assistant
model KbArticle {
  id         String   @id @default(uuid())
  category   String   // 'policy'|'faq'|'provider_info'|'booking_guide'|'credits'
  title      String
  content    String   @db.Text
  lang       String   @default("ne")  // 'ne' | 'en'
  updatedAt  DateTime @updatedAt

  @@map("kb_articles")
}

// Assistant session log
model AssistantSession {
  id          String   @id @default(uuid())
  userId      Int?
  sessionId   String   @unique
  contextType String?
  contextId   String?
  messages    Json     // [{ role, content, retrieved_chunks }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        user?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("assistant_sessions")
}

// Trust score event log
model TrustScoreEvent {
  id         String   @id @default(uuid())
  providerId Int
  score      Float
  prevScore  Float
  trigger    String   // 'review'|'complaint'|'vouch'|'decay'|'booking'
  inputs     Json     // full breakdown snapshot
  aiFlags    Json?
  modelVer   String?
  createdAt  DateTime @default(now())

  provider   provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@map("trust_score_events")
}

// KYC AI decision log
model KycAiDecision {
  id            String   @id @default(uuid())
  providerId    Int
  ocrResult     Json
  faceScore     Float?
  forgeryRisk   String   // 'low'|'medium'|'high'
  confidence    Float
  decision      String   // 'AUTO_APPROVE'|'HUMAN_QUEUE'
  adminOverride String?  // 'APPROVE'|'REJECT'
  modelVer      String
  createdAt     DateTime @default(now())

  provider      provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@map("kyc_ai_decisions")
}

// Content moderation log
model ModerationLog {
  id         String   @id @default(uuid())
  entityType String   // 'review'|'complaint'|'profile'
  entityId   String
  result     String   // 'PASSED'|'FLAGGED'
  category   String?
  confidence Float
  createdAt  DateTime @default(now())

  @@map("moderation_logs")
}

// Credit packs catalogue
model CreditPack {
  id          String    @id @default(uuid())
  name        String    // 'starter'|'active'|'pro'
  credits     Int
  priceNpr    Int
  features    Json      // array of feature strings
  isActive    Boolean   @default(true)
  purchases   CreditPurchase[]

  @@map("credit_packs")
}

// Credit purchase records
model CreditPurchase {
  id            String     @id @default(uuid())
  providerId    Int
  packId        String
  creditsAdded  Int
  amountNpr     Int
  paymentMethod String     // 'khalti'|'esewa'
  paymentRef    String?
  status        String     // 'pending'|'completed'|'failed'
  createdAt     DateTime   @default(now())

  provider      provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  pack          CreditPack @relation(fields: [packId], references: [id])
  @@map("credit_purchases")
}

// Provider credit wallet
model CreditWallet {
  id           String   @id @default(uuid())
  providerId   Int      @unique
  balance      Int      @default(0)
  totalEarned  Int      @default(0)
  totalSpent   Int      @default(0)
  updatedAt    DateTime @updatedAt

  provider     provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@map("credit_wallets")
}

// Credit deduction log
model CreditDeduction {
  id          String   @id @default(uuid())
  providerId  Int
  amount      Int
  reason      String   // 'boost_booking_accepted'|'featured_slot'
  bookingId   Int?
  createdAt   DateTime @default(now())

  provider    provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  @@map("credit_deductions")
}

// Trust badge catalogue & purchases
model ProviderBadge {
  id           String   @id @default(uuid())
  providerId   Int
  badgeType    String   // 'skill_verified'|'background_checked'|'insured'
  status       String   // 'pending'|'active'|'expired'
  verifiedBy   Int?     // admin user ID
  expiresAt    DateTime?
  amountNpr    Int
  purchasedAt  DateTime @default(now())

  provider     provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  admin        user?    @relation("AdminVerifiedBadges", fields: [verifiedBy], references: [id], onDelete: SetNull)
  @@map("provider_badges")
}

// Reviews model
model Review {
  id          String   @id @default(uuid())
  bookingId   Int
  customerId  Int
  providerId  Int
  rating      Int      // 1-5
  comment     String   @db.Text
  reply       String?  @db.Text
  isAuthentic Boolean  @default(true)
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer    user     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider    provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@map("reviews")
}

// Complaints model
model Complaint {
  id            String   @id @default(uuid())
  bookingId     Int?
  customerId    Int
  providerId    Int
  type          String   // 'quality' | 'no-show' | 'overcharging' | 'abuse' | 'fraud'
  description   String   @db.Text
  status        String   @default("PENDING") // 'PENDING' | 'INVESTIGATING' | 'RESOLVED' | 'DISMISSED'
  adminResponse String?  @db.Text
  resolution    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer      user     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider      provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@map("complaints")
}
