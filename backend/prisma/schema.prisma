generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  PROVIDER
  MODERATOR
  ADMIN
}

enum KycTier {
  TIER_1_BASIC
  TIER_2_SKILLED
  TIER_3_VERIFIED
}

// Merged: used by both Booking.escrowStatus (default NONE) and EscrowPayment.status
enum EscrowStatus {
  NONE // no escrow on this booking (e.g. cash)
  PENDING // customer initiated, awaiting gateway confirmation
  HELD // funds captured, held by platform
  RELEASED // customer tapped "Job Complete" — paid out to provider
  REFUNDED // refunded to customer (dispute/cancellation)
  DISPUTED // under admin review
}

// Identity verification track — booking-access gate
enum IdentityStatus {
  INCOMPLETE
  PENDING_DOCUMENTS
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

// Skill verification track — additive trust signal, never a booking gate
enum SkillStatus {
  UNVERIFIED // no evidence submitted
  SELF_DECLARED // years/skills stated, no supporting evidence
  PENDING_REVIEW // evidence submitted, awaiting admin review
  VERIFIED // evidence reviewed and approved (Tier 1 by default)
}

// Platform-verified milestone badge — based on real booking history, not self-reporting
enum MilestoneBadge {
  NEW // < 5 completed bookings
  ESTABLISHED // 5–49 completed bookings
  TRUSTED_PRO // 50–199 completed + trust score > 70
  MASTER_PROVIDER // 200+ completed + trust score > 80
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum ComplaintType {
  SERVICE_QUALITY
  NO_SHOW
  OVERCHARGING
  ABUSIVE_BEHAVIOR
  FRAUD
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum BadgeType {
  SKILL_VERIFIED
  BACKGROUND_CHECKED
  INSURED
  FAST_RESPONDER
}

enum BadgeStatus {
  PENDING // fee paid, awaiting admin verification
  ACTIVE // verified and live on the provider profile
  EXPIRED // validity window (e.g. annual insurance) lapsed
  REJECTED // admin declined verification; fee refundable per policy
}

enum CreditReason {
  BOOST_BOOKING_ACCEPTED
  FEATURED_SLOT
}

enum PaymentMethod {
  KHALTI
  ESEWA
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  name         String    @db.VarChar(100)
  email        String?   @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  passwordHash String?   @db.VarChar(255)
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  fcmToken     String?   @db.VarChar(255)

  // Customer default service location (captured at registration).
  // district + city drive the nearest-provider matching; lat/long enable
  // haversine ranking. Any of these can be overridden per service request.
  city         String?   @db.VarChar(80)
  district     String?   @db.VarChar(80)
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)

  // Preferred gateway for booking checkout; prefills (never forces) the
  // payment method selector. Null = no preference set yet.
  preferredPaymentMethod PaymentMethod?

  deletedAt    DateTime? // soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  otps          Otp[]
  refreshTokens RefreshToken[]
  provider      Provider?
  bookings      Booking[]          @relation("CustomerBookings")
  reviews       Review[]
  complaints    Complaint[]        @relation("CustomerComplaints")
  sessions      AssistantSession[]
  messages      Message[]          @relation("SentMessages")
  addresses     SavedAddress[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Saved service addresses — reused to prefill the booking flow.
// ─────────────────────────────────────────────
model SavedAddress {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @db.Char(36)
  label       String   @db.VarChar(40) // Home | Office | Other (or custom)
  addressLine String   @db.VarChar(300)
  city        String?  @db.VarChar(100)
  landmark    String?  @db.VarChar(200)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_addresses")
}

// ─────────────────────────────────────────────
// OTP
// ─────────────────────────────────────────────

model Otp {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  code      String   @db.VarChar(6)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otps")
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// PROVIDER
// ─────────────────────────────────────────────

model Provider {
  id                      String    @id @default(uuid()) @db.Char(36)
  userId                  String    @unique @db.Char(36)
  legalName               String    @db.VarChar(100)
  profilePhoto            String?   @db.VarChar(500) // Cloudinary URL
  bio                     String?   @db.Text
  serviceArea             String?   @db.VarChar(100) // district/zone
  city                    String?   @db.VarChar(80)  // city the provider operates in (pairs with serviceArea district)
  yearsExperience         Int? // self-reported, plain text only — never badged alone
  identityStatus          String    @default("INCOMPLETE") @db.VarChar(20)
  // INCOMPLETE | PENDING_DOCUMENTS | UNDER_REVIEW | VERIFIED | REJECTED
  skillStatus             String    @default("UNVERIFIED") @db.VarChar(20)
  // UNVERIFIED | SELF_DECLARED | PENDING_REVIEW | VERIFIED
  milestoneBadge          String    @default("NEW") @db.VarChar(20)
  // NEW | ESTABLISHED | TRUSTED_PRO | MASTER_PROVIDER
  kycTier                 KycTier   @default(TIER_1_BASIC)
  completedBookings       Int       @default(0) // used for milestone recompute
  trustScore              Float     @default(0) @db.Float
  totalRevenue            Int       @default(0) // cumulative on-platform revenue (Verified Revenue Points, PRD §5.2)
  isAvailable             Boolean   @default(true)
  latitude                Decimal?  @db.Decimal(10, 7)
  longitude               Decimal?  @db.Decimal(10, 7)
  embedding               Json? // service description embedding vector
  identityRejectionReason String?   @db.Text
  skillRejectionReason    String?   @db.Text
  deletedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User                   @relation(fields: [userId], references: [id])
  skills        ProviderSkill[]
  categories    ProviderCategory[]
  documents     KycDocument[]
  skillEvidence SkillEvidence[]
  availability  ProviderAvailability[]
  bookings      Booking[]              @relation("ProviderBookings")
  reviews       Review[]
  complaints    Complaint[]            @relation("ProviderComplaints")
  trustEvents   TrustScoreEvent[]
  kycDecisions  KycAiDecision[]
  badges        ProviderBadge[]
  wallet        CreditWallet?
  purchases     CreditPurchase[]
  deductions    CreditDeduction[]

  @@index([identityStatus])
  @@index([skillStatus])
  @@index([trustScore])
  @@index([serviceArea])
  @@index([city])
  @@map("providers")
}

// ─────────────────────────────────────────────
// PROVIDER SKILLS & CATEGORIES
// ─────────────────────────────────────────────

model ProviderSkill {
  id         String @id @default(uuid()) @db.Char(36)
  providerId String @db.Char(36)
  skill      String @db.VarChar(100)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_skills")
}

model ProviderCategory {
  id         String @id @default(uuid()) @db.Char(36)
  providerId String @db.Char(36)
  categoryId String @db.Char(36)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([providerId, categoryId])
  @@map("provider_categories")
}

// ─────────────────────────────────────────────
// PROVIDER AVAILABILITY
// ─────────────────────────────────────────────

model ProviderAvailability {
  id         String @id @default(uuid()) @db.Char(36)
  providerId String @db.Char(36)
  dayOfWeek  Int // 0 = Sunday, 6 = Saturday
  startTime  String @db.VarChar(5) // "08:00"
  endTime    String @db.VarChar(5) // "18:00"

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_availability")
}

// ─────────────────────────────────────────────
// KYC DOCUMENTS
// ─────────────────────────────────────────────

model KycDocument {
  id           String   @id @default(uuid()) @db.Char(36)
  providerId   String   @db.Char(36)
  type         String   @db.VarChar(30) // 'government_id'|'selfie'
  cloudinaryId String   @db.VarChar(200) // Cloudinary public_id (restricted folder)
  url          String   @db.VarChar(500) // signed delivery URL (refreshed on access)
  uploadedAt   DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("kyc_documents")
}

// ─────────────────────────────────────────────
// SKILL EVIDENCE (v2.3 — separate, non-blocking track)
// ─────────────────────────────────────────────

model SkillEvidence {
  id               String    @id @default(uuid()) @db.Char(36)
  providerId       String    @db.Char(36)
  type             String    @db.VarChar(20) // 'certificate'|'work_photo'|'reference'
  cloudinaryId     String    @db.VarChar(200) // Cloudinary public_id (restricted folder)
  fileUrl          String    @db.VarChar(500) // signed delivery URL
  certNumber       String?   @db.VarChar(100) // extracted via OCR — for Phase 3 issuer lookup
  issuerName       String?   @db.VarChar(200) // extracted via OCR
  aiPrecheck       Json?
  // { documentType, ocrResult?, duplicateFlag?, stockPhotoFlag?, aiGeneratedFlag? }
  reviewStatus     String    @default("PENDING") @db.VarChar(20)
  // PENDING | APPROVED | REJECTED
  authenticityTier String    @default("NONE") @db.VarChar(10)
  // NONE | TIER_1 | TIER_2
  // TIER_1: AI pre-check + human visual review (not obviously fake — cannot prove genuine issuance)
  // TIER_2: certificate number confirmed against issuing institution's records (Phase 3 only)
  issuerVerified   Boolean   @default(false) // true only via Phase 3 CTEVT/institutional lookup
  issuerVerifiedAt DateTime?
  rejectReason     String?   @db.VarChar(500)
  reviewedBy       String?   @db.Char(36) // admin user ID
  isPaidBadge      Boolean   @default(false) // true = submitted via paid Skill Verified badge (7.4)
  createdAt        DateTime  @default(now())
  reviewedAt       DateTime?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([reviewStatus])
  @@map("skill_evidence")
}

// ─────────────────────────────────────────────
// KYC AI DECISION LOG
// ─────────────────────────────────────────────

model KycAiDecision {
  id            String   @id @default(uuid()) @db.Char(36)
  providerId    String   @db.Char(36)
  ocrResult     Json
  faceScore     Float?   @db.Float
  forgeryRisk   String   @db.VarChar(10) // 'low'|'medium'|'high'
  confidence    Float    @db.Float
  decision      String   @db.VarChar(20) // 'AUTO_APPROVE'|'HUMAN_QUEUE'
  adminOverride String?  @db.VarChar(10) // 'APPROVE'|'REJECT'
  modelVer      String   @db.VarChar(50)
  createdAt     DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("kyc_ai_decisions")
}

// ─────────────────────────────────────────────
// BOOKING
// ─────────────────────────────────────────────

model Booking {
  id            String        @id @default(uuid()) @db.Char(36)
  customerId    String        @db.Char(36)
  providerId    String        @db.Char(36)
  categoryId    String        @db.Char(36)
  status        BookingStatus @default(REQUESTED)
  escrowStatus  EscrowStatus  @default(NONE)
  isEmergency   Boolean       @default(false)
  hasGuarantee  Boolean       @default(true)
  neighborhood  String?       @db.VarChar(100)
  description   String?       @db.Text
  scheduledAt   DateTime
  completedAt           DateTime?
  completionLatitude    Decimal?      @db.Decimal(10, 7)
  completionLongitude   Decimal?      @db.Decimal(10, 7)
  priceNpr              Int?
  commission    Int? // platform commission in NPR
  paymentMethod PaymentMethod @default(CASH)
  isBoosted     Boolean       @default(false) // was booking from a boost slot?
  cancelReason  String?       @db.VarChar(500)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  User       @relation("CustomerBookings", fields: [customerId], references: [id])
  provider  Provider   @relation("ProviderBookings", fields: [providerId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])
  review    Review?
  complaint Complaint?
  messages  Message[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@map("bookings")
}

// ─────────────────────────────────────────────
// In-booking messaging — opens only after a booking is accepted
// (anti-spam: no pre-booking DMs). Both parties are Users; the
// provider participates via their linked User account.
// ─────────────────────────────────────────────
model Message {
  id        String    @id @default(uuid()) @db.Char(36)
  bookingId String    @db.Char(36)
  senderId  String    @db.Char(36) // User.id of the sender
  body      String    @db.VarChar(2000)
  readAt    DateTime? // set when the other party has seen it
  createdAt DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("SentMessages", fields: [senderId], references: [id])

  @@index([bookingId, createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────

model Review {
  id                String   @id @default(uuid()) @db.Char(36)
  bookingId         String   @unique @db.Char(36)
  customerId        String   @db.Char(36)
  providerId        String   @db.Char(36)
  rating            Int // 1–5
  comment           String?  @db.VarChar(500)
  isAuthentic       Boolean? // null = pending AI check, true = passed, false = flagged
  authenticityScore Float?   @db.Float
  providerReply     String?  @db.VarChar(500)
  isVisible         Boolean  @default(false) // hidden until AI screening passes
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id])
  customer User     @relation(fields: [customerId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([isVisible])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// COMPLAINT
// ─────────────────────────────────────────────

model Complaint {
  id          String          @id @default(uuid()) @db.Char(36)
  bookingId   String          @unique @db.Char(36)
  customerId  String          @db.Char(36)
  providerId  String          @db.Char(36)
  type        ComplaintType
  status      ComplaintStatus @default(OPEN)
  description String          @db.Text
  aiCategory  String?         @db.VarChar(50) // AI triage classification
  resolution  String?         @db.Text
  resolvedBy  String?         @db.Char(36) // admin user ID
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id])
  customer User     @relation("CustomerComplaints", fields: [customerId], references: [id])
  provider Provider @relation("ProviderComplaints", fields: [providerId], references: [id])

  @@index([status])
  @@index([providerId])
  @@map("complaints")
}

// ─────────────────────────────────────────────
// TRUST SCORE
// ─────────────────────────────────────────────

model TrustScoreEvent {
  id         String   @id @default(uuid()) @db.Char(36)
  providerId String   @db.Char(36)
  score      Float    @db.Float
  prevScore  Float    @db.Float
  trigger    String   @db.VarChar(20) // 'review'|'complaint'|'vouch'|'decay'|'booking'
  inputs     Json
  aiFlags    Json?
  modelVer   String?  @db.VarChar(50)
  createdAt  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("trust_score_events")
}

// ─────────────────────────────────────────────
// CREDITS
// ─────────────────────────────────────────────

model CreditPack {
  id       String  @id @default(uuid()) @db.Char(36)
  name     String  @db.VarChar(20) // 'starter'|'active'|'pro'
  credits  Int
  priceNpr Int
  features Json
  isActive Boolean @default(true)

  purchases CreditPurchase[]

  @@map("credit_packs")
}

model CreditPurchase {
  id            String        @id @default(uuid()) @db.Char(36)
  providerId    String        @db.Char(36)
  packId        String        @db.Char(36)
  creditsAdded  Int
  amountNpr     Int
  paymentMethod PaymentMethod
  paymentRef    String?       @db.VarChar(100)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  provider Provider   @relation(fields: [providerId], references: [id])
  pack     CreditPack @relation(fields: [packId], references: [id])

  @@index([providerId])
  @@map("credit_purchases")
}

model CreditWallet {
  id          String   @id @default(uuid()) @db.Char(36)
  providerId  String   @unique @db.Char(36)
  balance     Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  updatedAt   DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])

  @@map("credit_wallets")
}

model CreditDeduction {
  id         String       @id @default(uuid()) @db.Char(36)
  providerId String       @db.Char(36)
  amount     Int
  reason     CreditReason
  bookingId  String?      @db.Char(36)
  createdAt  DateTime     @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("credit_deductions")
}

// ─────────────────────────────────────────────
// BADGES
// ─────────────────────────────────────────────

model ProviderBadge {
  id          String      @id @default(uuid()) @db.Char(36)
  providerId  String      @db.Char(36)
  badgeType   BadgeType
  status      BadgeStatus @default(PENDING)
  verifiedBy  String?     @db.Char(36)
  expiresAt   DateTime?
  amountNpr   Int

  // Payment (PRD §4.3 badge fees) — verified against Khalti/eSewa before PENDING.
  paymentMethod String? @db.VarChar(10) // KHALTI | ESEWA
  paymentRef    String? @db.VarChar(100) // gateway ref (pidx / txn uuid) — idempotency key

  // Supporting evidence — insurance document for the Insured badge (Cloudinary).
  documentUrl String? @db.VarChar(500)
  documentId  String? @db.VarChar(200)

  rejectionReason String?   @db.VarChar(500)
  reviewedAt      DateTime?
  purchasedAt     DateTime  @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([status])
  @@map("provider_badges")
}

// ─────────────────────────────────────────────
// MODERATION LOG
// ─────────────────────────────────────────────

model ModerationLog {
  id         String   @id @default(uuid()) @db.Char(36)
  entityType String   @db.VarChar(20) // 'review'|'complaint'|'profile'
  entityId   String   @db.Char(36)
  result     String   @db.VarChar(10) // 'PASSED'|'FLAGGED'
  category   String?  @db.VarChar(50)
  confidence Float    @db.Float
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@map("moderation_logs")
}

// ─────────────────────────────────────────────
// RAG KNOWLEDGE BASE
// ─────────────────────────────────────────────

// FULLTEXT index applied via raw SQL migration
// See: prisma/migrations/add_fulltext_index.sql
model KbArticle {
  id        String   @id @default(uuid()) @db.Char(36)
  category  String   @db.VarChar(50) // 'policy'|'faq'|'provider_info'|'booking_guide'|'credits'
  title     String   @db.VarChar(500)
  content   String   @db.Text
  lang      String   @default("ne") @db.VarChar(5) // 'ne'|'en'
  updatedAt DateTime @updatedAt

  @@map("kb_articles")
}

// ─────────────────────────────────────────────
// ASSISTANT SESSION
// ─────────────────────────────────────────────

model AssistantSession {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String?  @db.Char(36)
  sessionId   String   @unique @db.VarChar(100)
  contextType String?  @db.VarChar(20) // 'booking'|'provider'|'complaint'|'general'
  contextId   String?  @db.Char(36)
  messages    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@map("assistant_sessions")
}

// ─────────────────────────────────────────────
// EXISTING — update Category model to add relation
// ─────────────────────────────────────────────

model Category {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String   @unique @db.VarChar(100)
  nameNp        String   @db.VarChar(100)
  icon          String?  @db.VarChar(100)
  description   String?  @db.Text
  descriptionNp String?  @db.Text
  slug          String   @unique @db.VarChar(100)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  // Relations
  subCategories SubCategory[]
  providers     ProviderCategory[]
  bookings      Booking[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// NEW — Level 2: Sub-category
// e.g. Plumbing → Pipe Work, Bathroom Fitting, Water Tank
// ─────────────────────────────────────────────

model SubCategory {
  id            String   @id @default(uuid()) @db.Char(36)
  categoryId    String   @db.Char(36)
  name          String   @db.VarChar(100)
  nameNp        String   @db.VarChar(100)
  description   String?  @db.Text
  descriptionNp String?  @db.Text
  slug          String   @db.VarChar(100)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("sub_categories")
}

// ─────────────────────────────────────────────
// NEW — Level 3: Specific Service with pricing
// e.g. Pipe Work → Fix leaking pipe (NPR 500–1500)
// ─────────────────────────────────────────────

model Service {
  id            String  @id @default(uuid()) @db.Char(36)
  subCategoryId String  @db.Char(36)
  name          String  @db.VarChar(200)
  nameNp        String  @db.VarChar(200)
  description   String? @db.Text
  descriptionNp String? @db.Text
  slug          String  @db.VarChar(100)

  // Pricing
  pricingType String  @db.VarChar(20) // 'fixed'|'range'|'quote'
  priceMin    Int? // NPR — null if 'quote'
  priceMax    Int? // NPR — null if 'fixed'
  priceFixed  Int? // NPR — used when pricingType='fixed'
  priceUnit   String? @db.VarChar(30) // 'per visit'|'per hour'|'per sq ft'

  // Meta
  estimatedMinutes Int? // avg completion time
  includedTasks    Json? // string[] of what's included
  excludedTasks    Json? // string[] of what's NOT included
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([subCategoryId, slug])
  @@index([subCategoryId])
  @@map("services")
}
// ============================================================
// GharSewa Nepal — Section 5: Anti-Disintermediation Features
// Merge these models/enums into your existing prisma/schema.prisma
// Assumes existing models: User, Provider, Booking
// After merging run: npx prisma migrate dev --name anti_disintermediation
// ============================================================

// ---------- 5.1 Escrow-Based Milestone Payments ----------
// (EscrowStatus is defined once at the top of this file — merged enum)

enum PaymentGateway {
  KHALTI
  ESEWA
}

model EscrowPayment {
  id             String         @id @default(cuid())
  bookingId      String         @unique
  customerId     String
  providerId     String
  gateway        PaymentGateway
  status         EscrowStatus   @default(PENDING)
  amountPaisa    Int // total amount in paisa (NPR * 100)
  commissionPct  Decimal        @db.Decimal(5, 2) // 8.00 / 10.00 / 12.00
  commissionPaisa Int           @default(0)
  payoutPaisa    Int            @default(0) // amount released to provider
  gatewayRef     String? // pidx (Khalti) / transaction_uuid (eSewa)
  gatewayTxnId   String? // final transaction id from gateway
  heldAt         DateTime?
  releasedAt     DateTime?
  refundedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  guarantee ServiceGuarantee?

  @@index([customerId])
  @@index([providerId, status])
  @@index([gatewayRef])
}

// ---------- 5.2 Service Guarantee Credits ----------

enum GuaranteeStatus {
  ACTIVE
  CLAIMED
  RESOLVED
  EXPIRED
}

model ServiceGuarantee {
  id           String          @id @default(cuid())
  escrowId     String          @unique
  bookingId    String          @unique
  customerId   String
  providerId   String
  status       GuaranteeStatus @default(ACTIVE)
  expiresAt    DateTime // releasedAt + 7 days
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  escrow EscrowPayment    @relation(fields: [escrowId], references: [id])
  claims GuaranteeClaim[]

  @@index([providerId, status])
  @@index([status, expiresAt])
}

model GuaranteeClaim {
  id          String   @id @default(cuid())
  guaranteeId String
  customerId  String
  description String   @db.Text
  photoUrls   Json? // array of Cloudinary URLs
  resolution  String?  @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  guarantee ServiceGuarantee @relation(fields: [guaranteeId], references: [id])

  @@index([guaranteeId])
}

// Verified Revenue Points — boost search ranking for on-platform revenue
model RevenuePointLedger {
  id          String   @id @default(cuid())
  providerId  String
  bookingId   String
  points      Int // 1 point per NPR 100 of on-platform revenue
  reason      String // ESCROW_RELEASE | EMERGENCY_COMPLETE | ADJUSTMENT
  createdAt   DateTime @default(now())

  @@index([providerId, createdAt])
}

// Off-platform leakage signals detected by the leakage job
enum LeakageFlagStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

model LeakageFlag {
  id         String            @id @default(cuid())
  providerId String
  customerId String?
  bookingId  String?
  signal     String // e.g. PHONE_IN_CHAT | CANCEL_AFTER_CONTACT | COMPLAINT_PATTERN
  details    Json?
  status     LeakageFlagStatus @default(OPEN)
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?

  @@index([providerId, status])
}

// ---------- 5.3 Emergency Dispatch Mode ----------

enum EmergencyStatus {
  SEARCHING // matching nearest providers
  DISPATCHED // offers sent to candidates
  ACCEPTED // a provider accepted
  IN_PROGRESS
  COMPLETED
  EXPIRED // no provider accepted in time
  CANCELLED
}

model EmergencyRequest {
  id            String          @id @default(cuid())
  customerId    String
  category      String // plumber | electrician | cleaner | ...
  description   String?         @db.Text
  latitude      Decimal         @db.Decimal(10, 7)
  longitude     Decimal         @db.Decimal(10, 7)
  addressLabel  String?
  status        EmergencyStatus @default(SEARCHING)
  commissionPct Decimal         @default(12.00) @db.Decimal(5, 2)
  acceptedById  String? // providerId that accepted
  acceptedAt    DateTime?
  completedAt   DateTime?
  expiresAt     DateTime // dispatch window deadline
  bookingId     String?         @unique // booking created after acceptance
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  offers EmergencyOffer[]

  @@index([customerId])
  @@index([status, expiresAt])
}

enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model EmergencyOffer {
  id          String      @id @default(cuid())
  requestId   String
  providerId  String
  distanceKm  Decimal     @db.Decimal(6, 2)
  status      OfferStatus @default(SENT)
  sentAt      DateTime    @default(now())
  respondedAt DateTime?

  request EmergencyRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, providerId])
  @@index([providerId, status])
}

// Fast Responder badge tracking (accept within 5 minutes)
// Renamed from ProviderBadge — that name is already used by the paid-badge model above.
// This model tracks performance-EARNED badges (free, awarded by the system).
model EarnedBadge {
  id         String    @id @default(cuid())
  providerId String
  badge      String // FAST_RESPONDER | SKILLED | TRUST | INSURED
  awardedAt  DateTime  @default(now())
  expiresAt  DateTime? // Fast Responder re-evaluated monthly

  @@unique([providerId, badge])
  @@index([badge])
  @@map("earned_badges")
}

// ---------- 5.4 Hyper-Local Neighborhood Tags ----------

// Geofenced areas (e.g. Maharajgunj) — seeded by ops team
model NeighborhoodArea {
  id        String  @id @default(cuid())
  name      String  @unique // "Maharajgunj"
  city      String // "Kathmandu"
  latitude  Decimal @db.Decimal(10, 7) // centroid
  longitude Decimal @db.Decimal(10, 7)
  radiusKm  Decimal @default(1.50) @db.Decimal(5, 2)

  completions NeighborhoodCompletion[]

  @@index([city])
}

// One row per GPS-verified job completion inside a geofence
model NeighborhoodCompletion {
  id          String   @id @default(cuid())
  areaId      String
  providerId  String
  bookingId   String   @unique
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  completedAt DateTime @default(now())

  area NeighborhoodArea @relation(fields: [areaId], references: [id])

  @@index([providerId, completedAt])
  @@index([areaId, completedAt])
}